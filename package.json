{
  "name": "aidos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "aidos domain kernel and dsh tool layer. Builds B0 (kernel), B1 (tools, guards, tiers).",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "patch:dsh": "bash patches/apply-dsh-patches.sh",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-web-react": "0.0.1-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "main": "./dist/host/aidos-plugin.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.0.1-rc.3",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8"
  },
  "exports": {
    ".": "./dist/host/aidos-plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "overrides": {
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8"
  }
}
